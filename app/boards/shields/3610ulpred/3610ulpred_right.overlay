#include "3610ulpred.dtsi"
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

&default_transform {
	col-offset = <5>;
};

/{
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
    // Right half: kscan col index 0 = innermost physical column.
    // Net names on the right sheet run col10 (inner) -> col14 (outer).
    col-gpios
    	= <&gpio1 15 GPIO_ACTIVE_HIGH>//net col10, P1.15 (transform col 5, inner)
        , <&gpio1 14 GPIO_ACTIVE_HIGH>//net col11, P1.14 (transform col 6)
        , <&gpio1 13 GPIO_ACTIVE_HIGH>//net col12, P1.13 (transform col 7)
        , <&gpio1 12 GPIO_ACTIVE_HIGH>//net col13, P1.12 (transform col 8)
        , <&gpio1 11 GPIO_ACTIVE_HIGH>//net col14, P1.11 (transform col 9, outer)
        ;
	row-gpios
        = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //net row10, P0.02 (top)
        , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //net row11, P0.03
        , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //net row12, P0.28
        , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //net row13, P0.29 (bottom)
        ;
    };
};

/*
 * PS/2 TrackPoint via UART (kb_zmk_ps2_mouse_trackpoint_driver module) — ENABLED
 *
 * Hardware chain: Sprintek SK8707-50/51 pointing stick -> 36daughter2 board
 * (module in J5, 8-pin FPC) -> daughter J1/J2 12-pin bus -> keyboard J3.
 * Daughter J5 maps the SK8707 pins onto the J3 bus nets as:
 *   SK8707 1 VCC      -> +3V3
 *   SK8707 2 IPD RST  -> daughter J5 pin 2 = CS/SS net = P0.31 (XIAO Plus only)
 *                        regular XIAO: RST driven on NFC2/P0.10 (net DR, J3 pin 5);
 *                        daughter2 currently lands DR on J5 pin 7 — route DR to
 *                        J5 pin 2 for the regular-XIAO option. Active high, int. pull-down.
 *   SK8707 3 GND      -> GND
 *   SK8707 4 IPD DATA -> SDA net    = P0.04  (UART RX)
 *   SK8707 5 IPD CLK  -> SCL net    = P0.05  (GPIO)
 *   SK8707 6/7/8 LEFT/MIDDLE/RIGHT -> MOSI/DR/MISO nets — buttons unused
 *   Dummy UART TX:        P0.27  (internal, not exposed)
 *   Dummy UART RX (off):  P1.01  (net EncoderA/GPIO1 — unused, parking only)
 *
 * Build the right half with:
 *   -DZMK_EXTRA_MODULES="/workspaces/zmk/app/kb_zmk_ps2_mouse_trackpoint_driver-main"
 */
#define MOUSE_PS2_DRIVER_UART

#define MOUSE_PS2_PIN_SCL <&gpio0 5 GPIO_ACTIVE_HIGH>
#define MOUSE_PS2_PIN_SDA <&gpio0 4 GPIO_ACTIVE_HIGH>
#define MOUSE_PS2_PIN_SDA_PINCTRL <NRF_PSEL(UART_RX, 0, 4)>
/* RST pin — pick by XIAO variant. RST is a static/low-frequency signal, so any
 * GPIO qualifies; the choice is about which pads the module exposes:
 *   regular XIAO nRF52840: NFC2 / P0.10 (net DR). NFC1/NFC2 are released as
 *                          GPIOs by the &uicr { nfct-pins-as-gpios; } node below.
 *   XIAO nRF52840 Plus:    P0.31 (net CS/SS) — only the Plus exposes P0.31 (D16). */
#define MOUSE_PS2_PIN_RST <&gpio0 10 GPIO_ACTIVE_HIGH>   /* regular XIAO: NFC2 P0.10 (net DR) */
// #define MOUSE_PS2_PIN_RST <&gpio0 31 GPIO_ACTIVE_HIGH>   /* XIAO Plus: P0.31 (net CS/SS) */

#define MOUSE_PS2_UART_BAUD_RATE <14400>

#define MOUSE_PS2_PIN_UNEXPOSED_TX <NRF_PSEL(UART_TX, 0, 27)>
#define MOUSE_PS2_PIN_UNEXPOSED_RX <NRF_PSEL(UART_RX, 1, 1)>

/*
 * Regular XIAO nRF52840: release NFC1/NFC2 (P0.09/P0.10) as plain GPIOs.
 * Zephyr 4.1: this devicetree property is the current mechanism; the old
 * CONFIG_NFCT_PINS_AS_GPIOS Kconfig still exists but is marked DEPRECATED.
 * hal_nordic turns the property into the NFCT_PINS_AS_GPIOS define for the MDK,
 * which writes UICR.NFCPINS once on first boot (persists until a UICR erase).
 * Harmless on a XIAO Plus.
 */
&uicr {
    nfct-pins-as-gpios;
};

/*
 * Interrupt priority overrides — gpiote at highest (0), all others demoted to 3
 * (required by the PS/2 driver for reliable bit timing on nRF52)
 */
&gpiote { interrupts = < 6 0 >; };
&clock { interrupts = < 0 3 >; };
&power { interrupts = < 0 3 >; };
&radio { interrupts = < 1 3 >; };
&uart0 { interrupts = < 2 3 >; };
&i2c0 { interrupts = < 3 3 >; };
&spi0 { interrupts = < 3 3 >; };
&i2c1 { interrupts = < 4 3 >; };
&spi1 { interrupts = < 4 3 >; };
&nfct { interrupts = < 5 3 >; };
&adc { interrupts = < 7 3 >; };
&timer0 { interrupts = < 8 3 >; };
&timer1 { interrupts = < 9 3 >; };
&timer2 { interrupts = < 10 3 >; };
&rtc0 { interrupts = < 11 3 >; };
&temp { interrupts = < 12 3 >; };
&rng { interrupts = < 13 3 >; };
&ecb { interrupts = < 14 3 >; };
&ccm { interrupts = < 15 3 >; };
&wdt { interrupts = < 16 3 >; };
&rtc1 { interrupts = < 17 3 >; };
&qdec { interrupts = < 18 3 >; };
&comp { interrupts = < 19 3 >; };
&egu0 { interrupts = < 20 3 >; };
&egu1 { interrupts = < 21 3 >; };
&egu2 { interrupts = < 22 3 >; };
&egu3 { interrupts = < 23 3 >; };
&egu4 { interrupts = < 24 3 >; };
&egu5 { interrupts = < 25 3 >; };
&timer3 { interrupts = < 26 3 >; };
&timer4 { interrupts = < 27 3 >; };
&pwm0 { interrupts = < 28 3 >; };
&pdm0 { interrupts = < 29 3 >; };
&pwm1 { interrupts = < 33 3 >; };
&pwm2 { interrupts = < 34 3 >; };
&spi2 { interrupts = < 35 3 >; };
&rtc2 { interrupts = < 36 3 >; };
&i2s0 { interrupts = < 37 3 >; };
&usbd { interrupts = < 39 3 >; };
&uart1 { interrupts = < 40 3 >; };
&qspi { interrupts = < 41 3 >; };
&pwm3 { interrupts = < 45 3 >; };
&spi3 { interrupts = < 47 3 >; };
&cryptocell { interrupts = < 42 3 >; };

/*
 * Pinctrl — UART0 states for PS/2
 */
&pinctrl {
	uart0_ps2_default: uart0_ps2_default {
		group1 {
			psels = MOUSE_PS2_PIN_UNEXPOSED_TX,
					MOUSE_PS2_PIN_SDA_PINCTRL;
		};
	};
	uart0_ps2_sleep: uart0_ps2_sleep {
		group1 {
			psels = MOUSE_PS2_PIN_UNEXPOSED_TX,
					MOUSE_PS2_PIN_SDA_PINCTRL;
			low-power-enable;
		};
	};
	uart0_ps2_off: uart0_ps2_off {
		group1 {
			psels = MOUSE_PS2_PIN_UNEXPOSED_TX,
					MOUSE_PS2_PIN_UNEXPOSED_RX;
		};
	};
};

/*
 * UART0 — reconfigured for PS/2 (parent must be okay: the uart-ps2 driver
 * binds to it via DEVICE_DT_GET(DT_INST_BUS))
 */
&uart0 {
    status = "okay";
    compatible = "nordic,nrf-uarte";
    current-speed = MOUSE_PS2_UART_BAUD_RATE;
    pinctrl-0 = <&uart0_ps2_default>;
    pinctrl-1 = <&uart0_ps2_off>;
    pinctrl-names = "default", "sleep";

    uart_ps2: uart_ps2 {
        status = "okay";
        compatible = "uart-ps2";
        scl-gpios = MOUSE_PS2_PIN_SCL;
        sda-gpios = MOUSE_PS2_PIN_SDA;
    };
};

/*
 * PS/2 Mouse input device and listener
 */
/ {
    mouse_ps2: mouse_ps2 {
        status = "okay";
        compatible = "zmk,input-mouse-ps2";
        ps2-device = <&uart_ps2>;
        rst-gpios = MOUSE_PS2_PIN_RST;
    };

    /* Mainline ZMK input listener. The module's own zmk,input-listener-ps2
     * (input_listener_ps2.c) predates the pointing refactor and no longer
     * compiles (includes zmk/mouse/types.h); the mouse_ps2 device emits
     * standard zephyr input events, so the stock listener handles it. */
    mouse_ps2_input_listener: mouse_ps2_input_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&mouse_ps2>;
    };
};
