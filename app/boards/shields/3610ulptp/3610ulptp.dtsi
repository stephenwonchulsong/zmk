#include <dt-bindings/zmk/matrix_transform.h>
/*
36ChULP10 — 36v10_ULP_combo PCB (38 keys = 369ulptp layout + 2 center thumb keys)

Accessory pin map from the v10 PCB (J3 right / J101 left, same pins both halves):
CS(SS) pin is P0.31
DR is P0.10
Encoder A and B are P1.01 and P0.09
SDA P0.04
SCL P0.05
MISO P1.05
MOSI P1.07
SCK  P1.03
BTN3 P0.15
*/
// Encoders (provision only — J3/J101 EncoderA/B pads; wired identically on both halves)
// /{
//     sensors: sensors {
//         compatible = "zmk,keymap-sensors";
//         sensors = <
//         &left_encoder
//         &right_encoder
//         >;
//         triggers-per-rotation = <24>;
//     };
//     left_encoder: encoder_left {
//         compatible = "alps,ec11";
//         a-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // EncoderA_L P1.01
//         b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // EncoderB_L P0.09
//         steps = <48>;
//         status = "disabled";
//     };
//     right_encoder: encoder_right {
//         compatible = "alps,ec11";
//         a-gpios = <&gpio1 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // EncoderA P1.01
//         b-gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // EncoderB P0.09
//         steps = <48>;
//         status = "disabled";
//     };
// };
/{
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
    col-gpios
    	= <&gpio1 15 GPIO_ACTIVE_HIGH>//Col0 (net col10/col110, P1.15)
        , <&gpio1 14 GPIO_ACTIVE_HIGH>//Col1 (net col11/col111, P1.14)
        , <&gpio1 13 GPIO_ACTIVE_HIGH>//Col2 (net col12/col112, P1.13)
        , <&gpio1 12 GPIO_ACTIVE_HIGH>//Col3 (net col13/col113, P1.12)
        , <&gpio1 11 GPIO_ACTIVE_HIGH>//Col4 (net col14/col114, P1.11)
        ;
	row-gpios
        = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //Row0 top    (net row10/row110, P0.02)
        , <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   //Row1        (net row11/row111, P0.03)
        , <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //Row2        (net row12/row112, P0.28)
        , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //Row3 bottom (net row13/row113, P0.29)
        ;
    };
};

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <10>;
		rows = <4>;
// Physical layout, v10 combo PCB refdes (left half | right half):
// |   ---  | SW104 | SW103 | SW102 | SW101 |         | SW1  | SW2  | SW3  | SW4  |  ---  |
// |  SW109 | SW108 | SW107 | SW106 | SW105 |         | SW7  | SW8  | SW9  | SW10 | SW11  |
// |  SW114 | SW113 | SW112 | SW111 | SW110 |         | SW13 | SW14 | SW15 | SW16 | SW17  |
// |  SW118 |  ---  | SW117 | SW116 | SW115 | SW120 | SW45 | SW18 | SW19 | SW20 |  ---  | SW21 |
//
// SW120 / SW45 are the NEW v10 inner thumb keys: RC(3,1) and RC(3,8) — the matrix
// slots that were unused on 369ulptp. They are appended at the END of the map
// (keymap positions 36 and 37) so the original 36 key positions keep the same
// indices and every combo in ../369p/369p_behaviors.dtsi stays valid unchanged.
		map = <
        RC(0,1) RC(0,2) RC(0,3) RC(0,4)       RC(0,5) RC(0,6) RC(0,7) RC(0,8)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)       RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)       RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
RC(3,0)         RC(3,2) RC(3,3) RC(3,4)       RC(3,5) RC(3,6) RC(3,7)         RC(3,9)
RC(3,1) RC(3,8)
		>;
	};
};
