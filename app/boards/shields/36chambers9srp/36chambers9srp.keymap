west build -d build/369srpleft -p -b xiao_ble//zmk -- -DSHIELD=36chambers9srp_left
west build -d build/369srpright -p -b xiao_ble//zmk -- -DSHIELD=36chambers9srp_right

docker cp naughty_cohen:/workspaces/zmk/app/build/369srpleft/zephyr/zmk.uf2 "/Users/song100/Library/Mobile Documents/com~apple~CloudDocs/Keyboard/36firmware/36chambers9srp_left.uf2"
docker cp naughty_cohen:/workspaces/zmk/app/build/369srpright/zephyr/zmk.uf2 "/Users/song100/Library/Mobile Documents/com~apple~CloudDocs/Keyboard/36firmware/36chambers9srp_right.uf2"
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>        
#include <dt-bindings/zmk/pointing.h>

#define qwerty 0
#define lower 1
#define raise 2
#define adjust 3
#define commandlayer 4
#define extra 5
#define mouse 6
// #define cmtoqw 6
// #define lock 7
// #define locklow 8
// #define unlock 9
// #define lockhigh 10
#define ZMK_POINTING_DEFAULT_MOVE_VAL 3500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include "../369p/369p_behaviors.dtsi"

/{
    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            bindings = <  
    &homef17mm 0 0  &kp W           &kp E               &kp R               &kp T                 &tns N7 Y           &tns N8 U           &tns N9 I       &tns PLUS O         &kp F12
    &kp Q           &bhm LCTL S           &mnl mouse D        &mnl extra F        &kp G           &tns N4 H           &tns N5 J           &tns N6 K       &tns MINUS L        &bhm LSHFT P
    &bhm LALT A           &bhm LCTRL X    &bhm LALT C         &bhm LGUI V         &bhm LGUI B     &tns N1 N           &tns N2 M           &comlpar_ht N3 0 &dotrpar           &qmt_t RSHFT SEMI
    &bhm LSHFT Z                    &gresc_f17 F17 0 &qlt lower BSPC &tabgui 0 RET   &mnl raise SPACE    &lt raise TAB       &kp F18         &mkp MB1            &mt RSHFT FSLH
    &mkp MB1        &mkp MB1         &mkp MB1              &mkp MB1          &mkp MB1         
                >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp J K>;
        };
        colemak_layer {
            bindings = <
    &homef17mm 0 0  &kp W           &kp F               &kp P               &kp G           &kp J               &kp L               &kp U           &kp Y               &kp F12
    &kp Q           &kp R           &dmousecombo 0 D        &mnl extra T        &kp D           &kp H               &kp N               &kp E           &kp I               &kp SEMI
    &kp A           &bhm LCTRL X    &bhm LALT C         &bhm LGUI V         &bhm LGUI B     &kp K               &kp M               &comlpar        &dotrpar            &kp O      
    &bhm LSHFT Z                    &dmousecombo2 0 MB1 &qlt lower BSPC     &tabgui 0 RET   &mnl raise SPACE    &lt raise TAB       &kp F18         &mkp MB1            &mt RSHFT FSLH
    &mkp MB1        &mkp MB1         &mkp MB1              &mkp MB1          &mkp MB1                          
                 >;
sensor-bindings = <&inc_dec_kp X Y &scroll_up_down>;
        };

        lower_layer {
            bindings = <
    &copypastelink  &lefttop         &toptop               &righttop         &kp LG(LS(N5))   &tns AMPS N7       &tns ASTRK N8    &tns LT N9    &kp PLUS         &to 0 
    &kp LG(LBKT)    &leftleft        &centercenter         &rightright       &R1WR2W          &tns DLLR N4       &tns PRCNT N5    &tns CARET N6 &kp MINUS        &kp EQUAL
    &kp C_VOL_UP    &leftbot         &botbot               &rightbot         &bhm LGUI B      &tns EXCL N1       &tns AT N2       &tns POUND N3 &kp DOT          &bhm LSHFT EQUAL
    &kp C_VOL_DN                     &mkp MB2              &qlt lower BSPC   &tabgui 0 RET    &mnl adjust N0     &lt adjust TAB   &kp F18       &mkp MB1         &mt RSHFT FSLH
    &mkp MB1        &mkp MB1         &mkp MB1              &mkp MB1          &mkp MB1         
                >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp J K>;
        };
        raise_layer {
            bindings = <
    &mkp MB2        &kp F2           &kp F3                &kp F4            &kp F5           &kp F6             &kp F7           &kp UP        &kp F9           &to 1
    &kp F1          &kp LCTL         &kp LALT              &kp LGUI          &none            &none              &kp LEFT         &kp DOWN      &kp RIGHT        &kp RET
    &kp LSHFT       &bhm LCTRL X     &bhm LALT C           &bhm LGUI V       &bhm LGUI B      &tns LBRC LBKT     &tns RBRC RBKT   &kp SQT       &kp DQT          &bhm LSHFT RIGHT
    &bhm LSHFT Z                     &trans                &qlt adjust DEL   &trans           &mnl raise SPACE   &lt raise TAB    &trans        &mkp MB1 &mt RSHFT BSLH
    &mkp MB2        &mkp MB2         &mkp MB2              &mkp MB2          &mkp MB2         
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp J K>;
        };
        adjust_layer {
            bindings = <
    &none           &none            &none                 &out OUT_TOG      &bt BT_CLR_ALL   &kp AMPS           &kp ASTRK        &LR_PAR       &kp EQUAL        &kp UNDER
    &bt BT_SEL 0    &bt BT_SEL 1     &bt BT_SEL 3          &bt BT_SEL 3      &bt BT_CLR       &kp DLLR           &kp PRCNT        &kp CARET     &kp UNDER        &kp PIPE
    &bhm LSHFT C_VOL_UP &bhm LCTRL X &bhm LALT C           &bhm LGUI V       &bhm LGUI B      &kp EXCL           &kp AT           &kp POUND     &none            &bhm LSHFT BSLH
    &bhm LSHFT C_VOL_DN              &trans                &qlt adjust DEL   &trans           &mnl adjust RPAR           &lt adjust TAB   &trans        &mkp MB1 &mt RSHFT BSLH
    &mkp MB1        &mkp MB1         &mkp MB1              &mkp MB1          &mkp MB1         
                >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp J K>;
        };
        commandllayer_layer {
            bindings = <
    &kp GRAVE       &arcwindow       &kp E                 &bhm LSHFT R      &kp T            &kp Y              &kp U            &kp I         &kp O            &kp TILDE
    &qtab2 0 TAB    &kp S            &kp D                 &kp F             &kp G            &kp H              &kp J            &kp K         &kp L            &kp RET
    &bhm LSHFT A    &bhm LCTRL X     &bhm LALT C           &tappaste       &bhm LGUI B      &kp N              &bhm LALT M      &comlpar      &dotrpar         &bhm LSHFT SEMI
    &bhm LSHFT Z                     &mkp MB1              &qlt lower DEL    &tabgui 0 RET          &mnl raise SPACE   &lt raise TAB    &kp ESC       &mkp MB1 &mt RSHFT FSLH
    &trans          &trans           &trans                &trans            &trans           
                >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp J K>;
        };        
        extra_layer {
            bindings = <
    &kp ESC         &kp W            &kp E                 &kp R             &kp T            &kp AMPS           &kp U            &kp I         &kp O            &kp RET
    &kp Q           &bhm LGUI S      &mt mouse LG(LS(SPACE)) &mo extra       &kp G            &kp PG_DN          &kp F18          &kp K         &textit          &bhm LSHFT P 
    &kp LC(LEFT)    &bhm LCTRL X     &copypaste            &bhm LGUI V       &textbf          &kp LBRC           &kp RBRC         &kp GRAVE     &kp SQT          &rightminusgt      
    &parencite                       &mkp MB2              &qlt lower DEL    &kp LS(LC(LA(LG(RET)))) &kp LS(LC(LA(LG(SPACE)))) &kp LS(LC(LA(LG(TAB)))) &kp CAPS &mkp MB1 &mt RSHFT BSLH
    &mkp MB2        &mkp MB2         &mkp MB2              &mkp MB2          &mkp MB2         
                >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp J K>;
        };
        mouse_layer {bindings = <
    &mkp MB1        &kp LG(LA(LEFT)) &mkp MB4              &kp LG(LA(RIGHT)) &kp T            &msc SCRL_UP       &msc SCRL_LEFT   &mmv MOVE_UP  &msc SCRL_RIGHT  &kp HOME
    &kp LG(LEFT)    &mkp MB2         &mo mouse             &mkp MB1          &kp LG(RIGHT)    &msc SCRL_DOWN     &mmv MOVE_LEFT   &mmv MOVE_DOWN &mmv MOVE_RIGHT &bhm LCTL P
    &msc SCRL_UP    &bhm LCTRL X     &bhm LALT C           &bhm LGUI V       &bhm LGUI B      &kp LBRC           &kp RBRC         &kp GRAVE     &kp SQT          &bhm LSHFT SEMI      
    &msc SCRL_DOWN                   &trans                &qlt lower BSPC   &kp RET          &mkp MB1           &mkp MB2         &kp CAPS      &mkp MB1 &mt RSHFT BSLH
    &mkp MB2        &mkp MB2         &mkp MB2              &mkp MB2          &mkp MB2         
           >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp J K>;
        };
    };
};
